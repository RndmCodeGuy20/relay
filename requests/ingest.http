@host = http://localhost:5972/api
@ingestPath = /v1/ingest

### 01 - valid order.created
POST {{host}}{{ingestPath}}
Content-Type: application/json

{
  "event_id": "11111111-1111-1111-1111-111111111111",
  "event_type": "order.created",
  "source": "shop-api",
  "schema_version": "v1",
  "payload": {
    "order_id": "ORD-1001",
    "customer_id": "CUS-9001",
    "amount_cents": 2599,
    "currency": "USD"
  },
  "occurred_at": "2026-04-18T10:00:00Z"
}

